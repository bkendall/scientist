{
  "name": "node-scientist",
  "version": "3.0.0",
  "description": "Helper to do Science!",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm run unit",
    "format": "npm run lint -- --fix",
    "integration": "mocha 'test/integration/**/*'",
    "lint": "npm run lint:format",
    "lint:format": "eslint --fix '{src,test,examples}/**/*' && prettier --write *.md .*.json tsconfig*.json",
    "prepare": "npm run clean && npm run build -- --build tsconfig.publish.json",
    "test": "npm run lint && npm run unit && npm run integration",
    "unit": "mocha 'src/**/*.spec.ts'"
  },
  "author": "Bryan Kendall <bryan@bryankendall.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkendall/scientist"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.8.0",
    "@types/chai": "^4.3.17",
    "@types/chai-as-promised": "^7.1.8",
    "@types/debug": "^4.1.7",
    "@types/knuth-shuffle": "^1.0.2",
    "@types/mocha": "^10.0.7",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "^10.1.2",
    "chai": "^5.1.1",
    "chai-as-promised": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "mocha": "^10.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "sinon": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "immutable": "^4.1.0",
    "knuth-shuffle": "^1.0.1"
  }
}
